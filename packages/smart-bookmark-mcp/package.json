{
  "name": "@ludengke95/smart-bookmark-mcp",
  "version": "1.0.3",
  "description": "MCP (Model Context Protocol) bridge server for the Smart Bookmark Chrome extension. Exposes your bookmarks/groups/tags to AI clients (Cursor, Claude Desktop, WorkBuddy, Windsurf, CherryStudio, Dify) over Native Messaging, Stdio proxy, and Streamable HTTP.",
  "type": "module",
  "bin": {
    "smart-bookmark-mcp": "./bin/smart-bookmark-mcp.js",
    "smart-bookmark-stdio": "./bin/smart-bookmark-stdio.js"
  },
  "files": [
    "bin",
    "src",
    "install-cli.mjs",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "register": "node ./bin/smart-bookmark-mcp.js register",
    "install-cli": "node ./install-cli.mjs"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bookmark",
    "chrome-extension",
    "cursor",
    "claude-desktop",
    "windsurf"
  ],
  "author": "ludengke95 <ludengke95@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ludengke95/smart-bookmark.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
