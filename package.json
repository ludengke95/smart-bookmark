{
  "name": "smart-bookmark",
  "version": "1.0.3",
  "private": true,
  "description": "> 基于客户端网络拓扑智能寻径的多入口 Chrome 扩展（Manifest V3）。解决同一个应用内网/外网入口不同，每次都需要手动判断该点哪个地址的问题。",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build -b chrome && wxt build -b edge",
    "zip": "wxt zip -b chrome && wxt zip -b edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip -b chrome && wxt zip -b edge",
    "compile": "wxt compile",
    "mcp": "node scripts/mcp-bridge.js",
    "mcp:register": "node packages/smart-bookmark-mcp/bin/smart-bookmark-mcp.js register",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "version:sync": "node scripts/sync-versions.mjs",
    "release:prepare": "node scripts/bump-version.mjs",
    "release:verify": "node scripts/verify-release-pr.mjs"
  },
  "keywords": [],
  "author": "ludengke95 <ludengke95@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@lucide/svelte": "^1.38.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "autoprefixer": "^10.5.4",
    "conventional-changelog-cli": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "lucide-svelte": "^1.0.1",
    "postcss": "^8.5.26",
    "svelte": "^5.57.0",
    "tailwindcss": "^3.4.19",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "^4.4.5"
  }
}
